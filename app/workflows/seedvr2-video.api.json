{
  "1": {
    "class_type": "VHS_LoadImagesPath",
    "inputs": { "directory": "C:/frames", "image_load_cap": 0, "skip_first_images": 0, "select_every_nth": 1 },
    "_meta": { "title": "IN_FRAMES" }
  },
  "2": {
    "class_type": "ResizeImageMaskNode",
    "inputs": { "input": ["1", 0], "resize_type": "scale longer dimension", "resize_type.longer_size": 3840, "scale_method": "lanczos" },
    "_meta": { "title": "IN_SIZE" }
  },
  "3": { "class_type": "SeedVR2Preprocess", "inputs": { "resized_images": ["2", 0] }, "_meta": { "title": "SeedVR2 Preprocess" } },
  "4": { "class_type": "VAELoader", "inputs": { "vae_name": "seedvr2_ema_vae_fp16.safetensors" }, "_meta": { "title": "Load VAE" } },
  "5": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "seedvr2_7b_int8_convrot.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load Diffusion Model" }
  },
  "6": {
    "class_type": "VAEEncodeTiled",
    "inputs": { "pixels": ["3", 0], "vae": ["4", 0], "tile_size": 512, "overlap": 128, "temporal_size": 64, "temporal_overlap": 8 },
    "_meta": { "title": "VAE Encode (Tiled)" }
  },
  "7": {
    "class_type": "SeedVR2TemporalChunk",
    "inputs": { "latent": ["6", 0], "temporal_overlap": 2, "chunking_mode": "auto" },
    "_meta": { "title": "SeedVR2 Temporal Chunk" }
  },
  "8": {
    "class_type": "SeedVR2Conditioning",
    "inputs": { "model": ["5", 0], "vae_conditioning": ["7", 0] },
    "_meta": { "title": "SeedVR2 Conditioning" }
  },
  "9": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["5", 0], "positive": ["8", 0], "negative": ["8", 1], "latent_image": ["7", 0],
      "seed": 42, "steps": 1, "cfg": 1, "sampler_name": "euler", "scheduler": "simple", "denoise": 1
    },
    "_meta": { "title": "IN_SEED" }
  },
  "10": {
    "class_type": "SeedVR2TemporalMerge",
    "inputs": { "latents": ["9", 0], "temporal_overlap": ["7", 1] },
    "_meta": { "title": "SeedVR2 Temporal Merge" }
  },
  "11": {
    "class_type": "VAEDecodeTiled",
    "inputs": { "samples": ["10", 0], "vae": ["4", 0], "tile_size": 512, "overlap": 128, "temporal_size": 64, "temporal_overlap": 8 },
    "_meta": { "title": "VAE Decode (Tiled)" }
  },
  "12": {
    "class_type": "SeedVR2PostProcessing",
    "inputs": { "images": ["11", 0], "original_resized_images": ["2", 0], "color_correction_method": "lab" },
    "_meta": { "title": "IN_COLOR" }
  },
  "13": {
    "class_type": "Image Save",
    "inputs": {
      "images": ["12", 0], "root": "temp", "filename_prefix": "brennglas_video/", "filename_delimiter": "_",
      "filename_number_padding": 4, "filename_number_start": false, "extension": "png", "dpi": 300, "quality": 100,
      "optimize_image": false, "lossless_webp": false, "overwrite_mode": true, "show_history": false,
      "show_history_by_prefix": true, "embed_workflow": false, "show_previews": false, "bit_depth": "16-bit",
      "filenames": "f0000"
    },
    "_meta": { "title": "OUT_FRAMES" }
  }
}
