{
  "name": "qwen21-t2i",
  "label": {
    "de": "Text to Image",
    "en": "Text to Image"
  },
  "inputs": {
    "prompt": {
      "node": "IN_PROMPT",
      "field": "value",
      "type": "string",
      "label": {
        "de": "Prompt",
        "en": "Prompt"
      },
      "placeholder": {
        "de": "Was soll zu sehen sein? Text in Anführungszeichen wird ins Bild geschrieben.",
        "en": "What should the image show? Text in quotes is written into the image."
      }
    },
    "aspect": {
      "node": "IN_RES",
      "field": "aspect_ratio",
      "type": "enum",
      "default": "1:1 (Square)",
      "options": [
        "1:1 (Square)",
        "2:3 (Portrait Photo)",
        "3:2 (Photo)",
        "3:4 (Portrait Standard)",
        "4:3 (Standard)",
        "9:16 (Portrait Widescreen)",
        "16:9 (Widescreen)",
        "21:9 (Ultrawide)"
      ],
      "label": {
        "de": "Format",
        "en": "Aspect ratio"
      }
    },
    "megapixels": {
      "node": "IN_RES",
      "field": "megapixels",
      "type": "float",
      "default": 2,
      "min": 0.1,
      "max": 4,
      "label": {
        "de": "Größe",
        "en": "Size"
      },
      "unit": "MP",
      "presets": [
        {
          "label": "Fast Draft",
          "value": 1
        },
        {
          "label": "Balanced",
          "value": 2
        },
        {
          "label": "High Quality",
          "value": 4
        }
      ]
    },
    "seed": {
      "node": "IN_SEED",
      "field": "noise_seed",
      "type": "int",
      "random": true,
      "min": 0,
      "max": 9007199254740991,
      "label": {
        "de": "Seed",
        "en": "Seed"
      }
    },
    "enhance": {
      "node": "IN_PE",
      "field": "value",
      "type": "bool",
      "default": false,
      "label": {
        "de": "Prompt erweitern lassen (lädt ein weiteres Modell)",
        "en": "Expand prompt (loads another model)"
      }
    },
    "loraOn": {
      "node": "IN_LORA_ON",
      "field": "value",
      "type": "bool",
      "default": false,
      "label": {
        "de": "LoRA nutzen",
        "en": "Use LoRA"
      }
    },
    "lora": {
      "node": "IN_LORA",
      "field": "lora_name",
      "type": "enum",
      "loras": "qwen21",
      "showIf": "loraOn",
      "label": {
        "de": "LoRA",
        "en": "LoRA"
      }
    },
    "loraStrength": {
      "node": "IN_LORA",
      "field": "strength_model",
      "type": "float",
      "default": 1,
      "min": 0,
      "max": 2,
      "step": 0.05,
      "showIf": "loraOn",
      "label": {
        "de": "LoRA-Stärke",
        "en": "LoRA strength"
      }
    },
    "loraTrigger": {
      "node": "IN_LORA_TRIGGER",
      "field": "value",
      "type": "string",
      "optional": true,
      "default": "",
      "fillFrom": "lora",
      "showIf": "loraOn",
      "label": {
        "de": "Trigger-Wort",
        "en": "Trigger word"
      },
      "placeholder": {
        "de": "leer = nichts anhängen",
        "en": "empty = append nothing"
      },
      "hint": {
        "de": "Kommt automatisch in den Prompt.",
        "en": "Added to the prompt automatically."
      }
    }
  },
  "outputs": {
    "image": {
      "node": "OUT_IMAGE"
    },
    "expandedPrompt": {
      "node": "OUT_CAPTION",
      "optional": true
    }
  }
}
