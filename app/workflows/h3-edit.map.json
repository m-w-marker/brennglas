{
  "name": "h3-edit",
  "label": {
    "de": "Bild bearbeiten",
    "en": "Image Edit"
  },
  "inputs": {
    "image": {
      "node": "IN_IMAGE",
      "field": "image",
      "type": "image",
      "label": {
        "de": "Ausgangsbild",
        "en": "Source image"
      }
    },
    "prompt": {
      "node": "IN_PROMPT",
      "field": "value",
      "type": "string",
      "label": {
        "de": "Anweisung",
        "en": "Instruction"
      },
      "placeholder": {
        "de": "Was soll sich ändern? z. B. „mach die Wand blau“",
        "en": "What should change? e.g. “make the wall blue”"
      }
    },
    "megapixels": {
      "node": "IN_RES",
      "field": "resize_type.megapixels",
      "type": "float",
      "default": 4,
      "min": 0.01,
      "max": 16,
      "label": {
        "de": "Größe",
        "en": "Size"
      },
      "unit": "MP",
      "presets": [
        {
          "label": "Fast Draft",
          "value": 4
        },
        {
          "label": "Balanced",
          "value": 9
        },
        {
          "label": "High Quality",
          "value": 16
        }
      ]
    },
    "seed": {
      "node": "IN_SEED",
      "field": "seed",
      "type": "int",
      "random": true,
      "min": 0,
      "max": 9007199254740991,
      "label": {
        "de": "Seed",
        "en": "Seed"
      }
    },
    "enhance": {
      "node": "IN_PE",
      "field": "value",
      "type": "bool",
      "default": true,
      "label": {
        "de": "Prompt erweitern lassen",
        "en": "Expand prompt"
      }
    }
  },
  "refs": {
    "max": 15,
    "token": "<Picture {n}>",
    "targets": [
      {
        "node": "IN_REFS",
        "prefix": "images.image_",
        "start": 2
      },
      {
        "node": "IN_PE_REFS",
        "prefix": "images.image",
        "start": 2
      }
    ]
  },
  "outputs": {
    "image": {
      "node": "OUT_IMAGE"
    },
    "expandedPrompt": {
      "node": "OUT_CAPTION",
      "optional": true
    }
  }
}
